# --- Discord (from https://discord.com/developers/applications) ---
# Your bot's token (Bot tab -> Reset Token)
DISCORD_TOKEN=
# Your application id (General Information -> Application ID)
DISCORD_CLIENT_ID=
# Optional: a server id to register commands to instantly while developing.
# Leave blank to register global commands (can take up to ~1 hour to appear).
DEV_GUILD_ID=

# --- Flash Props API ---
# Get a free key in 30 seconds at https://api.flashodds.live
FLASH_PROPS_API_KEY=
FLASH_PROPS_BASE_URL=https://api.flashodds.live

# --- Optional: auto-post a daily board to a channel ---
# Leave DAILY_CHANNEL_ID blank to disable the scheduled post.
DAILY_CHANNEL_ID=
DAILY_SPORT=mlb
# Cron in the host's timezone. Default: 5:00 PM daily.
DAILY_CRON=0 17 * * *
